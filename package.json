{
  "name": "@jqkgg/m-ui",
  "version": "1.0.7",
  "description": "一个基于 Vue3 的组件库",
  "type": "module",
  "main": "./dist/m-ui.umd.cjs",
  "module": "./dist/m-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/m-ui.js",
      "require": "./dist/m-ui.umd.cjs"
    },
    "./button": {
      "types": "./dist/components/Button/index.vue.d.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./dist/components/Input/index.vue.d.ts",
      "import": "./dist/input.js"
    },
    "./chart-bar": {
      "types": "./dist/components/ChartBar/index.vue.d.ts",
      "import": "./dist/chart-bar.js"
    },
    "./chart-bar-3d": {
      "types": "./dist/components/ChartBar3D/index.vue.d.ts",
      "import": "./dist/chart-bar-3d.js"
    },
    "./chart-pie": {
      "types": "./dist/components/ChartPie/index.vue.d.ts",
      "import": "./dist/chart-pie.js"
    },
    "./chart-pie-3d": {
      "types": "./dist/components/ChartPie3D/index.vue.d.ts",
      "import": "./dist/chart-pie-3d.js"
    },
    "./chart-line": {
      "types": "./dist/components/ChartLine/index.vue.d.ts",
      "import": "./dist/chart-line.js"
    },
    "./chart-map-cq": {
      "types": "./dist/components/ChartMapCq/index.vue.d.ts",
      "import": "./dist/chart-map-cq.js"
    },
    "./chart-map-cq-3d": {
      "types": "./dist/components/ChartMapCq3D/index.vue.d.ts",
      "import": "./dist/chart-map-cq-3d.js"
    },
    "./chart-word-cloud": {
      "types": "./dist/components/ChartWordCloud/index.vue.d.ts",
      "import": "./dist/chart-word-cloud.js"
    },
    "./chart-graph": {
      "types": "./dist/components/ChartGraph/index.vue.d.ts",
      "import": "./dist/chart-graph.js"
    },
    "./chart-radar": {
      "types": "./dist/components/ChartRadar/index.vue.d.ts",
      "import": "./dist/chart-radar.js"
    },
    "./chart-tree": {
      "types": "./dist/components/ChartTree/index.vue.d.ts",
      "import": "./dist/chart-tree.js"
    },
    "./chart-sunburst": {
      "types": "./dist/components/ChartSunburst/index.vue.d.ts",
      "import": "./dist/chart-sunburst.js"
    },
    "./chart-kline": {
      "types": "./dist/components/ChartKLine/index.vue.d.ts",
      "import": "./dist/chart-kline.js"
    },
    "./chart-pictorial-bar": {
      "types": "./dist/components/ChartPictorialBar/index.vue.d.ts",
      "import": "./dist/chart-pictorial-bar.js"
    },
    "./chart-funnel": {
      "types": "./dist/components/ChartFunnel/index.vue.d.ts",
      "import": "./dist/chart-funnel.js"
    },
    "./chart-gauge": {
      "types": "./dist/components/ChartGauge/index.vue.d.ts",
      "import": "./dist/chart-gauge.js"
    },
    "./responsive-page": {
      "types": "./dist/components/ResponsivePage/index.vue.d.ts",
      "import": "./dist/responsive-page.js"
    },
    "./scroll-box": {
      "types": "./dist/components/ScrollBox/index.vue.d.ts",
      "import": "./dist/scroll-box.js"
    },
    "./ellipsis-text": {
      "types": "./dist/components/EllipsisText/index.vue.d.ts",
      "import": "./dist/ellipsis-text.js"
    },
    "./gradation-text": {
      "types": "./dist/components/GradationText/index.vue.d.ts",
      "import": "./dist/gradation-text.js"
    },
    "./style.css": "./dist/style.css",
    "./component-style.css": "./dist/component-style.css"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.components.config.ts && npm run build:types",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json --outDir dist",
    "build:docs": "vitepress build docs",
    "verify:exports": "node scripts/verify-exports.mjs",
    "dev:docs": "vitepress dev docs",
    "preview:docs": "vitepress preview docs",
    "preview": "vite preview",
    "prepublishOnly": "npm run build && npm run verify:exports",
    "publish": "npm run build && npm publish --access public"
  },
  "keywords": [
    "vue3",
    "component-library",
    "ui",
    "typescript"
  ],
  "author": "jqkgg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqkgg/m-ui.git"
  },
  "homepage": "https://github.com/jqkgg/m-ui#readme",
  "bugs": {
    "url": "https://github.com/jqkgg/m-ui/issues"
  },
  "peerDependencies": {
    "@vueuse/core": "^10.0.0",
    "echarts": "^5.0.0",
    "echarts-gl": "^2.0.0",
    "echarts-wordcloud": "^2.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "echarts-gl": {
      "optional": true
    },
    "echarts-wordcloud": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "echarts-wordcloud": "^2.1.0",
    "element-plus": "^2.13.1",
    "postcss": "^8.4.35",
    "sass": "^1.69.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^5.0.0",
    "vitepress": "^1.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^3.2.2"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.0",
    "lodash": "^4.17.23"
  }
}
